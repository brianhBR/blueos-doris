# Loaded only by `vite build --mode demo` (yarn build:demo).
# The default `yarn build` used by extension/Dockerfile never reads this,
# so the vehicle bundle is unaffected.

VITE_DEMO_MODE=true

# GitHub Pages serves the project site from /<repo>/. Set to "/" if the
# demo ever moves to a host that serves from the domain root.
DEMO_BASE=/blueos-doris/
