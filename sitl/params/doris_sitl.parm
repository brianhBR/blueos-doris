# ─────────────────────────────────────────────────────────────────────────────
# DORIS SITL-only environment overrides.
#
# Layered LAST (after sub.parm and doris.parm) so it wins. These are pure
# simulation knobs and must NEVER ship to a real vehicle.
#
# The test drivers mutate several of these at runtime:
#   * sitl_monitor.py    discharges SIM_BATT_VOLTAGE and toggles
#                        SIM_GPS1_ENABLE as the vehicle dives/surfaces.
#   * /api/v1/dive/sitl/simulate_drop sets SIM_BUOYANCY = -19.6 (sink);
#     doris.lua sets SIM_BUOYANCY = +19.6 on weight release (rise).
# These lines are just the starting state for a fresh (--wipe) run.
# ─────────────────────────────────────────────────────────────────────────────

# --- Simulated battery -------------------------------------------------------
# ArduSub SITL subtracts up to ~4 V from SIM_BATT_VOLTAGE based on servo PWM
# deviation.  sitl_monitor.py models discharge from 16.8 V (VOLT_FULL); add
# the SITL parasitic sag so reported voltage matches the monitor at t=0.
SIM_BATT_VOLTAGE 20.8
BATT_MONITOR     4
BATT_FS_LOW_ACT  0
BATT_FS_CRT_ACT  0

# Keep servo outputs neutral — DORIS has no thrusters; avoids phantom drain.
SERVO1_TRIM      1500
SERVO2_TRIM      1500
SERVO3_TRIM      1500
SERVO4_TRIM      1500
SERVO5_TRIM      1500
SERVO6_TRIM      1500
SERVO7_TRIM      1500
SERVO8_TRIM      1500

# --- Buoyancy ----------------------------------------------------------------
SIM_BUOYANCY     0.0

# --- Barometer (SITL path) ---------------------------------------------------
BARO_EXT_BUS     -1
BARO_PROBE_EXT   0
SIM_BARO_RND     0.02
FS_PRESS_ENABLE  0

# --- GPS ---------------------------------------------------------------------
# Use built-in SITL GPS (production doris.parm may set GPS1_TYPE=14 for AGT).
GPS1_TYPE        1
SIM_GPS1_ENABLE  1

# --- Startup position (deterministic) ----------------------------------------
SIM_OPOS_LAT     33.810313
SIM_OPOS_LNG     -118.393867
SIM_OPOS_ALT     0.0
SIM_OPOS_HDG     270
SIM_SHOVE_Z      0
SIM_SHOVE_TIME   0

# --- Safety / arming ---------------------------------------------------------
BRD_SAFETYENABLE 0
# sitl_monitor.py also sets ARMING_CHECK=0; belt-and-suspenders for headless runs.
ARMING_CHECK     0
