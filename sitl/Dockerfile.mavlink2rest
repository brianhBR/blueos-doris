FROM alpine:3.19
ARG TARGETARCH
RUN apk add --no-cache curl && \
    case "${TARGETARCH}" in \
        amd64) BINARY=mavlink2rest-x86_64-unknown-linux-musl ;; \
        arm64) BINARY=mavlink2rest-aarch64-unknown-linux-musl ;; \
        arm)   BINARY=mavlink2rest-armv7-unknown-linux-musleabihf ;; \
        *)     echo "Unsupported arch: ${TARGETARCH}"; exit 1 ;; \
    esac && \
    curl -fsSL \
        "https://github.com/mavlink/mavlink2rest/releases/download/t0.11.24/${BINARY}" \
        -o /usr/bin/mavlink2rest && \
    chmod +x /usr/bin/mavlink2rest
ENTRYPOINT ["mavlink2rest"]
